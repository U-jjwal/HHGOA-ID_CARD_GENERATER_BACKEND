# Server
NODE_ENV=development
PORT=4000
# Public base URL of THIS backend (used to build /card/:id share links and OG image fallback)
BASE_URL=http://localhost:4000
# Public base URL of the frontend SPA (browsers get redirected here after the crawler sees the OG tags)
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/hh-goa-frames

# Redis (Upstash/Redis Cloud connection string in prod, e.g. rediss://default:pass@host:port)
REDIS_URL=redis://localhost:6379
# Seconds a card record is cached before falling back to Mongo (card data is immutable once created, so this can be long)
CARD_CACHE_TTL_SECONDS=2592000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
