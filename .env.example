# Server
NODE_ENV=development
PORT=4000
# Public base URL of THIS backend (used to build /card/:id share links and OG image fallback)
BASE_URL=http://localhost:4000
# Public base URL of the frontend SPA (browsers get redirected here after the crawler sees the OG tags)
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/hh-goa-frames

# Redis (Upstash/Redis Cloud connection string in prod, e.g. rediss://default:pass@host:port)
REDIS_URL=redis://localhost:6379
# Seconds a card record is cached before falling back to Mongo (card data is immutable once created, so this can be long)
CARD_CACHE_TTL_SECONDS=2592000

# ImageKit (from https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Path (relative to the ImageKit URL endpoint) of the uploaded frame overlay PNG, e.g. /branding/hh-goa-frame.png
IMAGEKIT_FRAME_OVERLAY_PATH=/branding/hh-goa-frame.png

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
